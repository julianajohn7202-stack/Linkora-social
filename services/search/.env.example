# OpenTelemetry OTLP exporter endpoint.
# Locally: point to Jaeger OTLP HTTP receiver (docker compose --profile monitoring up).
# Production: any OTLP-compatible backend (Grafana Tempo, Honeycomb, Datadog, …).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# HTTP port the search service listens on.
PORT=3003

# Node.js environment. Use "production" to disable pino-pretty transport.
NODE_ENV=development
