{
  "name": "@linkora/search",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Search service for Linkora — full-text and semantic search across profiles and posts",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
