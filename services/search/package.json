{
  "name": "@linkora/search",
  "version": "0.1.0",
  "description": "Linkora search service — full-text and on-chain entity search API",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
