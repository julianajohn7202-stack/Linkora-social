{
  "name": "linkora-search",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Linkora search service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js}\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.9.3",
    "tsx": "^4.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
