    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest"
  },
  "dependencies": {
    "@linkora/types": "workspace:*",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.3.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
