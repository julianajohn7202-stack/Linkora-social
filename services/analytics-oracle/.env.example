# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for the database the oracle reads analytics data
# from. The oracle runs read-only queries against the indexer's database — it
# does not maintain a schema of its own.
# REQUIRED — startup fails when unset.
# Production tip: store this in a secrets manager and inject at runtime.
#   Never commit a production value to source control.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkora

# ─────────────────────────────────────────────────────────────────────────────
# Stellar / Soroban
# ─────────────────────────────────────────────────────────────────────────────

# Horizon-compatible Soroban RPC endpoint used to submit on-chain attestations.
# REQUIRED — startup fails when unset.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  use a paid, rate-limited provider endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Bech32-encoded Soroban contract address (starts with "C") for the deployed
# Linkora smart contract the oracle attests to.
# REQUIRED — startup fails when unset.
CONTRACT_ID=

# Stellar network passphrase for signing attestation transactions.
# REQUIRED for mainnet — defaults to Testnet passphrase when unset.
# Testnet: "Test SDF Network ; September 2015"
# Mainnet: "Public Global Stellar Network ; September 2015"
NETWORK_PASSPHRASE=

# ─────────────────────────────────────────────────────────────────────────────
# Signing Key (Secrets Backend)
# ─────────────────────────────────────────────────────────────────────────────

# Hex-encoded Ed25519 private key (32 bytes). Generate a new key with:
#   node -e "require('crypto').randomBytes(32).toString('hex')"
#
# SECURITY: Never pass the private key through an environment variable in
# production. Instead write it to a file (Docker secret / K8s secret volume /
# AWS Secrets Manager mounted file) and configure the file backend:
#
#   SECRETS=file:///run/secrets/oracle-key.hex
#
# The file must contain the 32-byte key as lowercase hex (trailing newline OK).
# For LOCAL DEVELOPMENT ONLY you may use the env-var backend:
#
#   SECRETS=env:ORACLE_PRIVATE_KEY_HEX
#   ORACLE_PRIVATE_KEY_HEX=<hex>
#
# REQUIRED — startup fails when unset.
SECRETS=env:ORACLE_PRIVATE_KEY_HEX

# ─────────────────────────────────────────────────────────────────────────────
# Admin API
# ─────────────────────────────────────────────────────────────────────────────

# Bearer token that authenticates POST /admin/rotate-key.
# OPTIONAL but strongly recommended in production — leave empty to disable
# the admin key-rotation endpoint entirely.
# High-entropy example (generate with: openssl rand -hex 32):
#   ADMIN_SECRET=a3f8c2...
# SECURITY: store in a secrets manager; never hard-code in source control.
ADMIN_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Oracle Identity & Analytics
# ─────────────────────────────────────────────────────────────────────────────

# Human-readable identifier included in on-chain attestation payloads. Used to
# distinguish between multiple oracle instances if you run more than one.
# Optional — default: "default"
ORACLE_NAME=default

# Size of the sliding analytics window in ledgers. Each run processes this many
# ledgers of contract events. Approximately 1000 ledgers ≈ 83 minutes at the
# Stellar mainnet cadence of ~5 s/ledger.
# Optional — default: 1000
WINDOW_LEDGERS=1000

# ─────────────────────────────────────────────────────────────────────────────
# HTTP Server
# ─────────────────────────────────────────────────────────────────────────────

# Port the HTTP server listens on.
# Optional — default: 4000
PORT=4000

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting — Shared Store
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED when NODE_ENV=production. Redis endpoint shared by every replica,
# backing the rate limiter. Without it each replica keeps its own counters, so
# an attacker behind a load balancer gets `limit x replicaCount` throughput and
# rate limiting provides no real protection. Startup fails in production when
# this is unset.
# Production tip: use TLS (rediss://) and authenticate with a strong password.
REDIS_URL=redis://localhost:6379

# Escape hatch for a deliberately single-replica production deployment. When
# true, the service boots without REDIS_URL and reports
# `rateLimiter: { store: "memory", shared: false }` on /health. Never set this
# on a deployment that can scale past one replica.
# Optional — default: false
# ALLOW_IN_MEMORY_RATE_LIMIT=false

# ─────────────────────────────────────────────────────────────────────────────
# Per-IP Rate Limiting (Oracle HTTP Endpoints)
# ─────────────────────────────────────────────────────────────────────────────

# Sliding window duration for per-IP rate limiting, in milliseconds.
# Optional — default: 60000 (1 minute)
ORACLE_RATE_LIMIT_WINDOW_MS=60000

# Maximum number of requests allowed per IP within ORACLE_RATE_LIMIT_WINDOW_MS.
# Keep this low — the oracle's endpoints are infrequently polled by clients.
# Optional — default: 10
ORACLE_RATE_LIMIT_MAX_REQUESTS=10

# Comma-separated list of IP addresses exempt from rate limiting.
# Useful for internal health-check infrastructure that polls /health frequently.
# Example: ORACLE_RATE_LIMIT_BYPASS_IPS=10.0.0.1,10.0.0.2
# Optional — leave empty to apply rate limiting to all IPs
ORACLE_RATE_LIMIT_BYPASS_IPS=

# ─────────────────────────────────────────────────────────────────────────────
# Attestation Cache
# ─────────────────────────────────────────────────────────────────────────────

# Maximum number of creator attestations to hold in the in-memory LRU cache.
# Tune this based on your expected number of active creators. Each entry is
# small (<1 KB), so 10 000 entries ≈ 10 MB of heap.
# Optional — default: 10000
ATTESTATION_CACHE_MAX_SIZE=10000

# How long (ms) a cached attestation is valid before eviction. After this TTL
# expires the next request recomputes the attestation from the database.
# Set to 0 to disable TTL-based eviction (size limit still applies).
# Optional — default: 3600000 (1 hour)
ATTESTATION_CACHE_TTL_MS=3600000
