# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string used by the dm-relay at runtime.
# REQUIRED — startup fails when unset.
# Production tip: store this in a secrets manager (e.g. AWS Secrets Manager,
# HashiCorp Vault, K8s Secret) and inject it at runtime. Never commit a
# production value to source control.
DATABASE_URL=postgresql://username:password@localhost:5432/linkora_dm_relay

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────

# Port the HTTP server listens on.
# Optional — default: 3001
PORT=3001

# Runtime environment — affects error detail in HTTP responses and log
# formatting. Also controls whether REDIS_URL is required at startup.
# Values: development | production | test
# REQUIRED in production: set to "production" for deployed environments.
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Optional — default: http://localhost:3000
# In production set this to your actual frontend origin(s), e.g.:
#   CORS_ORIGIN=https://app.linkora.io,https://mobile.linkora.io
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────

# Maximum requests per minute for unauthenticated (anonymous) callers, keyed
# by client IP address.
# Optional — default: 100
RATE_LIMIT_ANON_RPM=100

# Maximum requests per minute for authenticated callers, keyed by Stellar
# address.
# Optional — default: 300
RATE_LIMIT_AUTH_RPM=300

# REQUIRED when NODE_ENV=production. Redis endpoint shared by every replica,
# backing both the HTTP limiters and the WebSocket per-IP connection limit.
# Without it each replica keeps its own counters, so an attacker behind a load
# balancer gets `limit x replicaCount` throughput and rate limiting provides no
# real protection. Startup fails in production when this is unset.
# Production tip: use TLS (rediss://) and authenticate with a strong password.
#   REDIS_URL=rediss://:strong-password@redis.internal:6380
REDIS_URL=redis://localhost:6379

# Escape hatch for a deliberately single-replica production deployment. When
# true, the service boots without REDIS_URL and reports
# `rateLimiter: { store: "memory", shared: false }` on /health. Never set this
# on a deployment that can scale past one replica.
# Optional — default: false
# ALLOW_IN_MEMORY_RATE_LIMIT=false

# Maximum WebSocket connection attempts per minute per IP.
# Optional — default: 30
WS_RATE_LIMIT_MAX=30

# ─────────────────────────────────────────────────────────────────────────────
# Message Storage
# ─────────────────────────────────────────────────────────────────────────────

# How long messages are retained before the automatic cleanup job deletes them.
# Increasing this raises storage costs; decreasing it affects message history
# for users who are offline for extended periods.
# Optional — default: 7 (days)
MESSAGE_TTL_DAYS=7

# Maximum allowed message size in bytes for WebSocket frames and message
# payloads. Frames larger than this are rejected with close code 1009.
# Optional — default: 65536 (64 KB)
MAX_MESSAGE_BYTES=65536

# How long idempotency keys are stored to prevent duplicate message
# submissions. Set to at least twice the maximum expected client retry window.
# Optional — default: 24 (hours)
IDEMPOTENCY_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────────────────────
# Stellar / Authentication
# ─────────────────────────────────────────────────────────────────────────────

# Stellar network identifier used for Stellar Auth (SEP-10) signature
# verification. Must match the network your clients sign for.
# Values: Testnet | Mainnet  (default: Testnet)
# REQUIRED in production: set to "Mainnet" for live deployments.
STELLAR_NETWORK=Testnet

# Maximum allowed clock skew between the client-supplied timestamp in a signed
# request and the server clock. Requests outside this window are rejected to
# prevent replay attacks.
# Optional — default: 300 (seconds / 5 minutes)
MAX_TIMESTAMP_SKEW=300

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────

# Minimum log level emitted by the pino logger. In production "info" or "warn"
# is recommended to reduce noise; use "debug" only while troubleshooting.
# Values: trace | debug | info | warn | error | fatal
# Optional — default: info
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Build / Deployment  (typically injected by CI — do not set manually)
# ─────────────────────────────────────────────────────────────────────────────

# Git commit SHA surfaced in the /health endpoint for traceability. Set by the
# CI pipeline at build time so every deployed image reports its exact source
# revision.
# Optional — default: "unknown" when not set
# COMMIT_SHA=
