{
  "name": "@linkora/media",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Media processing service for Linkora — image upload, resize, and CDN delivery",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "jest",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1176.0",
    "@linkora/types": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "blurhash": "2.0.5",
    "busboy": "^1.6.0",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "sharp": "0.35.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
