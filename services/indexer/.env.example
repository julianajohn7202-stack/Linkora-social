# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment — affects log formatting, error detail in HTTP responses,
# and whether the REDIS_URL check is enforced.
# Values: development | production | test  (default: development)
# REQUIRED in production: set to "production" for deployed environments.
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL superuser credentials used by Docker Compose to bootstrap the
# database container. These variables are consumed by the postgres Docker image
# and are NOT used by the indexer service directly.
# REQUIRED when running with Docker Compose.
POSTGRES_USER=linkora
POSTGRES_PASSWORD=linkora
POSTGRES_DB=linkora

# Full PostgreSQL connection string used by the indexer at runtime.
# REQUIRED — startup fails when unset.
# Production tip: store this in a secrets manager (e.g. AWS Secrets Manager,
# HashiCorp Vault, K8s Secret) and inject it at runtime. Never commit a
# production value to source control.
DATABASE_URL=postgresql://linkora:linkora@postgres:5432/linkora

# ─────────────────────────────────────────────────────────────────────────────
# Stellar / Soroban
# ─────────────────────────────────────────────────────────────────────────────

# Horizon-compatible Soroban RPC endpoint used to stream contract events.
# REQUIRED — startup fails when unset.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Bech32-encoded Soroban contract address (starts with "C") for the deployed
# Linkora smart contract.
# REQUIRED — startup fails when unset.
CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Ledger sequence number at which the indexer begins streaming events.
# Set this to the ledger at which the contract was deployed so the indexer
# does not spend time scanning pre-deployment history.
# REQUIRED — startup fails when unset.
# Default: 0 (scans from genesis — only suitable for local dev networks)
START_LEDGER=0

# ─────────────────────────────────────────────────────────────────────────────
# HTTP / WebSocket Server
# ─────────────────────────────────────────────────────────────────────────────

# Port the HTTP and WebSocket server listens on.
# Optional — default: 3000
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting — Shared Store
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED when NODE_ENV=production. Redis endpoint shared by every replica,
# backing the rate limiter. Without it each replica keeps its own counters, so
# an attacker behind a load balancer gets `limit x replicaCount` throughput and
# rate limiting provides no real protection. Startup fails in production when
# this is unset.
# Production tip: use TLS (rediss://) and authenticate with a strong password.
#   REDIS_URL=rediss://:strong-password@redis.internal:6380
REDIS_URL=redis://localhost:6379

# Escape hatch for a deliberately single-replica production deployment. When
# true, the service boots without REDIS_URL and reports
# `rateLimiter: { store: "memory", shared: false }` on /health. Never set this
# on a deployment that can scale past one replica.
# Optional — default: false
# ALLOW_IN_MEMORY_RATE_LIMIT=false

# Comma-separated list of origins allowed to make cross-origin requests to the
# API (e.g. https://app.linkora.example,https://staging.linkora.example).
# REQUIRED in production — with no value set, production rejects all
# cross-origin requests instead of defaulting to a permissive wildcard.
# Optional in development — leave empty to allow all origins locally.
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# Backpressure & Adaptive Polling
# ─────────────────────────────────────────────────────────────────────────────

# Maximum outbound Soroban RPC calls per second (token-bucket limiter).
# Increase if your RPC provider allows a higher quota; lower it to avoid 429s.
# Optional — default: 10
RPC_RATE_LIMIT_PER_SEC=10

# Minimum interval (ms) between event-stream polls when the ledger is advancing
# quickly. Lowering this increases freshness but costs more RPC quota.
# Optional — default: 100
MIN_POLL_INTERVAL_MS=100

# Maximum interval (ms) between event-stream polls (adaptive back-off ceiling).
# Raise this to reduce RPC load on idle networks.
# Optional — default: 5000
MAX_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# Live-Stream Circuit Breaker
# ─────────────────────────────────────────────────────────────────────────────

# Consecutive *persistent* stream failures before the circuit breaker opens.
# Transient transport faults (ECONNREFUSED, ETIMEDOUT, 429/5xx, pool checkout
# timeouts) are retried indefinitely and never count toward this threshold.
# Optional — default: 10
STREAM_CIRCUIT_BREAKER_THRESHOLD=10

# How long (ms) an open breaker waits before letting a single probe request
# through. Tune to match the expected recovery time of your RPC provider.
# Optional — default: 30000 (30 seconds)
STREAM_CIRCUIT_BREAKER_PROBE_INTERVAL_MS=30000

# ─────────────────────────────────────────────────────────────────────────────
# WebSocket Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────

# Per-connection inbound WebSocket message budget per second. A connection that
# keeps sending frames once its bucket is empty is disconnected (close code
# 1008) after 5 consecutive over-budget frames.
# Optional — default: 5
WS_RATE_LIMIT_PER_SEC=5

# Burst capacity for the WebSocket rate limiter. Defaults to WS_RATE_LIMIT_PER_SEC
# when unset; set higher to allow short bursts without disconnecting well-behaved clients.
# Optional — default: same as WS_RATE_LIMIT_PER_SEC
# WS_RATE_LIMIT_BURST=5

# Maximum allowed inbound WebSocket frame size in bytes. Frames larger than
# this are rejected with close code 1009 (message too large).
# Optional — default: 65536 (64 KB)
WS_MAX_MESSAGE_BYTES=65536

# ─────────────────────────────────────────────────────────────────────────────
# Backfill / Gap Recovery
# ─────────────────────────────────────────────────────────────────────────────

# Maximum ledgers to backfill in one recovery run. Gaps larger than this
# trigger an alert instead of an unbounded backfill.
# Optional — default: 10000
BACKFILL_MAX_DEPTH_LEDGERS=10000

# Number of ledgers fetched per batch during backfill. Higher values speed up
# recovery but increase memory usage and RPC load.
# Optional — default: 100
BACKFILL_BATCH_SIZE=100

# Milliseconds to wait between backfill batches (rate limiting).
# Optional — default: 100
BACKFILL_RATE_LIMIT_MS=100

# Emit an alert when a detected gap exceeds this many ledgers.
# Optional — default: 5000
BACKFILL_ALERT_THRESHOLD=5000

# Stop backfilling after this many consecutive batch failures (circuit breaker).
# Optional — default: 5
BACKFILL_CIRCUIT_BREAKER_MAX_FAILURES=5

# ─────────────────────────────────────────────────────────────────────────────
# raw_events Retention / Partition Management
# ─────────────────────────────────────────────────────────────────────────────

# Number of ledgers to keep before dropping old partitions (≈ 231 days at
# Stellar mainnet cadence of ~5 s/ledger).
# Optional — default: 4000000
RAW_EVENTS_RETENTION_LEDGERS=4000000

# Ledger range per partition bucket. Must match the value in migration
# 012_raw_events_partitioned.sql — do not change after the first migration.
# Optional — default: 1000000
RAW_EVENTS_PARTITION_SIZE=1000000

# Set to "true" to detach old partitions instead of dropping them (archive
# mode). Useful when you want to move old data to cold storage before removing
# it entirely.
# Optional — default: false
RAW_EVENTS_ARCHIVE_ONLY=false

# cron schedule for the retention job (standard 5-field cron syntax).
# Optional — default: every hour at minute 5
RAW_EVENTS_RETENTION_CRON="5 * * * *"
