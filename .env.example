# Linkora Social Platform - Local Development Environment Variables

# PostgreSQL configuration
POSTGRES_USER=linkora
POSTGRES_PASSWORD=linkora
POSTGRES_DB=linkora

# Redis configuration
REDIS_URL=redis://redis:6379

# Stellar Soroban configuration
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=Testnet
CONTRACT_ID=
START_LEDGER=0

# Service Ports
INDEXER_PORT=3000
DM_RELAY_PORT=3001
NOTIFICATION_PORT=3002
MEDIA_PORT=3003
SEARCH_PORT=3004
ORACLE_PORT=4000

# Published Docker Compose ports (container ports stay fixed).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# INDEXER_HOST_PORT=3000
# DM_RELAY_HOST_PORT=3001
# NOTIFICATION_HOST_PORT=3002
# MEDIA_HOST_PORT=3003
# SEARCH_HOST_PORT=3004
# ORACLE_HOST_PORT=4000
