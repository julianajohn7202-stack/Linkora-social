{
  "name": "@linkora/codegen",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx generate.ts && prettier --write \"$(cd ../../ && pwd)/packages/sdk/src/generated/*.ts\"",
    "validate": "tsx check-drift.ts",
    "check:drift": "tsx check-drift.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
